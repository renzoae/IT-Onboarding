<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRE IT Onboarding - Local Administrator"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="18" Padding="22" Background="White" CornerRadius="10" BorderBrush="#D5DDE8" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Local Administrator Account" FontSize="19" FontWeight="SemiBold" Foreground="#0B2A4A"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#44546A"
                       Text="Choose the local administrator account for this laptop. The password is used once to create the account and is never saved, logged or written to the USB drive."/>

            <TextBlock Text="Local Administrator Username" FontWeight="SemiBold" Foreground="#0B2A4A"/>
            <TextBox x:Name="UserNameBox" Margin="0,4,0,12" Padding="6,5" MaxLength="20"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#0B2A4A"/>
            <PasswordBox x:Name="PasswordBox1" Margin="0,4,0,12" Padding="6,5" MaxLength="127"/>

            <TextBlock Text="Confirm Password" FontWeight="SemiBold" Foreground="#0B2A4A"/>
            <PasswordBox x:Name="PasswordBox2" Margin="0,4,0,10" Padding="6,5" MaxLength="127"/>

            <TextBlock x:Name="PolicyText" TextWrapping="Wrap" Foreground="#44546A" FontSize="12" Margin="0,0,0,8"/>

            <Border x:Name="ErrorPanel" Background="#FDECEC" BorderBrush="#D64545" BorderThickness="1" CornerRadius="6"
                    Padding="10" Margin="0,4,0,8" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A12B2B"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32" Margin="0,0,10,0" IsCancel="True"/>
                <Button x:Name="OkButton" Content="Create Account" Width="140" Height="32" IsDefault="True"
                        Background="#0B2A4A" Foreground="White" BorderBrush="#0B2A4A"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
